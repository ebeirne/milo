# Server-side provider credentials. Never prefix these with NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
ELEVENLABS_API_KEY=
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# Phase 1 requires a premade stock voice. George is the provider's example voice.
ELEVENLABS_STOCK_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# Local Docker Compose only. For a hosted database, use its connection URL.
# Never use these development credentials for a public deployment.
DATABASE_URL=postgresql://familiar:familiar_local@127.0.0.1:5432/familiar
