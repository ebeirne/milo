# Phase 0 does not call either provider. Add keys before Phase 1.
GEMINI_API_KEY=
# Verify the current model names during Phase 1 before setting these.
GEMINI_CHAT_MODEL=
ELEVENLABS_API_KEY=
ELEVENLABS_TTS_MODEL=
# Local Docker Compose only. For a hosted database, use its connection URL.
# Never use these development credentials for a public deployment.
DATABASE_URL=postgresql://familiar:familiar_local@127.0.0.1:5432/familiar
